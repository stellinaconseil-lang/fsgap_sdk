<Project>

  <!-- Settings shared by every project in the FSGAP_SDK solution. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <Deterministic>true</Deterministic>

    <!--
      Development version of the feature/synaptic-a220 branch. 0.9.0 is immutable: it is the version FSHANGAR restores
      from artifacts/packages. Preview packages go to a separate folder (below) and Directory.Build.targets refuses to
      pack 0.9.0 or to overwrite any existing package. 0.10.0 final is reserved for after the BLOCK 10B.3 qualification.
    -->
    <Version>0.10.0-preview.5</Version>
    <Product>FSGAP_SDK</Product>
    <Authors>FSGAP_SDK contributors</Authors>
    <RepositoryUrl>https://github.com/stellinaconseil-lang/fsgap_sdk</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/stellinaconseil-lang/fsgap_sdk</PackageProjectUrl>
    <PackageTags>flight-simulator;msfs;aircraft;telemetry;failures;sdk</PackageTags>
  </PropertyGroup>

  <!-- Library projects: packable, documented. -->
  <PropertyGroup Condition="!$(MSBuildProjectName.EndsWith('.Tests'))">
    <IsPackable>true</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!-- Not artifacts/packages: that folder is FSHANGAR's "fsgap-local" NuGet source and must only hold stable releases. -->
    <PackageOutputPath>$(MSBuildThisFileDirectory)artifacts/preview-packages</PackageOutputPath>
  </PropertyGroup>
  <ItemGroup Condition="!$(MSBuildProjectName.EndsWith('.Tests'))">
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <!-- Test projects: never packaged. -->
  <PropertyGroup Condition="$(MSBuildProjectName.EndsWith('.Tests'))">
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

</Project>
