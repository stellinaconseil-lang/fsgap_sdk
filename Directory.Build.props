<Project>

  <!-- Settings shared by every project in the FSGAP_SDK solution. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <Deterministic>true</Deterministic>

    <!--
      Single version of every package. 0.9.0 is immutable: it is the version FSHANGAR restores from artifacts/packages.
      Directory.Build.targets refuses to pack 0.9.0, to overwrite any existing package, or to shadow one of the stable
      feed. Output folders are below.
    -->
    <Version>0.12.0-preview.6</Version>
    <Product>FSGAP_SDK</Product>
    <Authors>FSGAP_SDK contributors</Authors>
    <RepositoryUrl>https://github.com/stellinaconseil-lang/fsgap_sdk</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/stellinaconseil-lang/fsgap_sdk</PackageProjectUrl>
    <PackageTags>flight-simulator;msfs;aircraft;telemetry;failures;sdk</PackageTags>
  </PropertyGroup>

  <!-- Library projects: packable, documented. -->
  <PropertyGroup Condition="!$(MSBuildProjectName.EndsWith('.Tests'))">
    <IsPackable>true</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!--
      Never artifacts/packages: that folder is FSHANGAR's "fsgap-local" NuGet source (0.9.0). Pre-release versions
      (with a "-" suffix) go to artifacts/preview-packages; a final version to its own artifacts/releases/<version>.
    -->
    <PackageOutputPath Condition="$(Version.Contains('-'))">$(MSBuildThisFileDirectory)artifacts/preview-packages</PackageOutputPath>
    <PackageOutputPath Condition="!$(Version.Contains('-'))">$(MSBuildThisFileDirectory)artifacts/releases/$(Version)</PackageOutputPath>
  </PropertyGroup>
  <ItemGroup Condition="!$(MSBuildProjectName.EndsWith('.Tests'))">
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <!-- Test projects: never packaged. -->
  <PropertyGroup Condition="$(MSBuildProjectName.EndsWith('.Tests'))">
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

</Project>
