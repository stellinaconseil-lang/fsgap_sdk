<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The application sample: what FSHANGAR or FLIPPP write. One reference, the top-level FSGAP project (in an application:
    one PackageReference Include="FSGAP"); no provider is composed here. A sample, never packed.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>FSGAP.Runtime.Console</RootNamespace>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\FSGAP\FSGAP.csproj" />
  </ItemGroup>

</Project>
