<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>FSGAP.Fenix</RootNamespace>
    <Description>FSGAP_SDK aircraft provider for the Fenix Simulations A319/A320/A321: aircraft recognition, normalized identity, the installed Fenix livery catalog, generic and Fenix system telemetry, and Fenix failures through the local EFB (normalized failure keys).</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\FSGAP.Abstractions\FSGAP.Abstractions.csproj" />
    <ProjectReference Include="..\FSGAP.Core\FSGAP.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="FSGAP.Fenix.Tests" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Failures\Resources\fenix-failure-catalog.json" LogicalName="FSGAP.Fenix.Failures.fenix-failure-catalog.json" />
    <EmbeddedResource Include="Failures\Resources\fenix-failure-mapping.json" LogicalName="FSGAP.Fenix.Failures.fenix-failure-mapping.json" />
  </ItemGroup>

</Project>
