<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>FSGAP.Synaptic</RootNamespace>
    <Description>FSGAP_SDK aircraft provider for the Synaptic Simulations A220-300: aircraft recognition, normalized identity, generic telemetry with the A220 policy, a small documented cockpit overlay (fuel boost pump modes, APU switches, engine fire pushbuttons), the installed A220 livery catalog built on the simulator's livery enumeration, four controlled degradations, and the normalized failure key set of the Fenix provider realized through documented A22X control recipes (17 executable), and the aircraft's 55 cockpit circuit breakers (cell trip and reset, executable only as the application's breaker options allow).</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\FSGAP.Abstractions\FSGAP.Abstractions.csproj" />
    <ProjectReference Include="..\FSGAP.Core\FSGAP.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="FSGAP.Synaptic.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- 0.13.0-preview.4: the 55 circuit breakers, generated from the lab evidence by tools/synaptic-cb-manifest/generate.py. -->
    <EmbeddedResource Include="CircuitBreakers\Resources\synaptic-a220-circuit-breakers.json" LogicalName="FSGAP.Synaptic.CircuitBreakers.synaptic-a220-circuit-breakers.json" />
  </ItemGroup>

</Project>
