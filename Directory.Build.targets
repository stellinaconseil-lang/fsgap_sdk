<Project>

  <!--
    Package protection: FSGAP 0.9.0 is immutable.

    The 0.9.0 packages in artifacts/packages were built on 2026-09-24 from e2f27eb and are restored by FSHANGAR (its
    "fsgap-local" NuGet source). main has evolved since while still declaring 0.9.0, so packing main would produce
    different binaries under the same package identity. NuGet caches packages by id and version: machines that already
    restored 0.9.0 would keep the old files, others would silently get the new ones.

    - Packing version 0.9.0 always fails. main may build and test normally, but can never create another 0.9.0 package.
    - No pack may overwrite an existing .nupkg with the same id and version in the output folder. Bump the version.
  -->
  <Target Name="FsgapProtectPublishedPackages" BeforeTargets="GenerateNuspec" Condition="'$(IsPackable)' == 'true'">
    <PropertyGroup>
      <_FsgapPackageFile>$(PackageId).$(PackageVersion).nupkg</_FsgapPackageFile>
    </PropertyGroup>
    <Error Condition="'$(PackageVersion)' == '0.9.0'"
           Text="FSGAP 0.9.0 is immutable and must never be rebuilt or repacked (the published 0.9.0 packages are consumed by FSHANGAR). Refusing to pack $(PackageId) 0.9.0; develop under a new version." />
    <Error Condition="Exists('$(PackageOutputPath)/$(_FsgapPackageFile)')"
           Text="$(_FsgapPackageFile) already exists in $(PackageOutputPath). Refusing to overwrite a published package version; bump the version." />
  </Target>

</Project>
