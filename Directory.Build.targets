<Project>

  <!--
    Package protection: published FSGAP packages are immutable.

    FSHANGAR restores FSGAP 0.9.0 from artifacts/packages (its "fsgap-local" NuGet source); those packages were built on
    2026-09-24 from e2f27eb. NuGet caches packages by id and version: a different file under the same version is
    silently ignored by machines that already restored it and silently used by those that did not. So:

    - Packing version 0.9.0 always fails. The tree may build and test normally, but can never create another 0.9.0.
    - No pack may overwrite an existing .nupkg with the same id and version in the output folder (preview/RC packages
      in artifacts/preview-packages, final releases in artifacts/releases/<version>, see Directory.Build.props).
    - No pack may shadow a package with the same id and version in the stable feed folder artifacts/packages.
    Bump the version instead.
  -->
  <Target Name="FsgapProtectPublishedPackages" BeforeTargets="GenerateNuspec" Condition="'$(IsPackable)' == 'true'">
    <PropertyGroup>
      <_FsgapPackageFile>$(PackageId).$(PackageVersion).nupkg</_FsgapPackageFile>
      <_FsgapStableFeed>$(MSBuildThisFileDirectory)artifacts/packages</_FsgapStableFeed>
    </PropertyGroup>
    <Error Condition="'$(PackageVersion)' == '0.9.0'"
           Text="FSGAP 0.9.0 is immutable and must never be rebuilt or repacked (the published 0.9.0 packages are consumed by FSHANGAR). Refusing to pack $(PackageId) 0.9.0; develop under a new version." />
    <Error Condition="Exists('$(PackageOutputPath)/$(_FsgapPackageFile)')"
           Text="$(_FsgapPackageFile) already exists in $(PackageOutputPath). Refusing to overwrite a published package version; bump the version." />
    <Error Condition="Exists('$(_FsgapStableFeed)/$(_FsgapPackageFile)')"
           Text="$(_FsgapPackageFile) already exists in the stable feed $(_FsgapStableFeed). Refusing to shadow it; bump the version." />
  </Target>

  <!--
    Package provenance (0.13.0-preview.4). The 0.13.0-preview.3 assemblies carry the commit of 0.13.0-preview.1 in their
    informational version while their nuspec carries the preview.3 commit: they were compiled from a working tree whose
    changes were committed only afterwards, then packed. So a pack is refused:
    - from a working tree with uncommitted changes to tracked or untracked (not ignored) files: the commit recorded in the
      assemblies and in the nuspec would not be the source that was compiled;
    - with NoBuild (dotnet pack -\-no-build): the assemblies could come from an earlier build of another commit.
    FsgapAllowDirtyPack=true lifts the first rule for a local experiment only; such a package must never be distributed.
  -->
  <Target Name="FsgapRequireCommittedSourceForPack" BeforeTargets="GenerateNuspec" Condition="'$(IsPackable)' == 'true'">
    <Exec Command="git status --porcelain" WorkingDirectory="$(MSBuildThisFileDirectory)" ConsoleToMSBuild="true" StandardOutputImportance="low" Condition="'$(FsgapAllowDirtyPack)' != 'true'">
      <Output TaskParameter="ConsoleOutput" ItemName="_FsgapUncommitted" />
    </Exec>
    <Error Condition="'@(_FsgapUncommitted)' != ''"
           Text="Refusing to pack $(PackageId) $(PackageVersion): the working tree has uncommitted changes, so the commit recorded in the package would not be the source compiled. Commit first (see Directory.Build.targets)." />
    <Error Condition="'$(NoBuild)' == 'true'"
           Text="Refusing to pack $(PackageId) $(PackageVersion) with NoBuild: the assemblies must be compiled from the commit recorded in the package (see Directory.Build.targets)." />
  </Target>

  <!--
    Exact internal pins (0.12.0-preview.3): a package's dependency on another FSGAP package (a ProjectReference) is
    written as [version], not the NuGet default minimum (>= version). The SDK's packages are built and tested together,
    so an application referencing FSGAP [x] gets exactly the internal packages of x, never a mix of versions.
    _ProjectReferencesWithVersions is filled by NuGet's _GetProjectReferenceVersions and turned into nuspec dependencies.
  -->
  <Target Name="FsgapPinInternalDependencies" AfterTargets="_GetProjectReferenceVersions" Condition="'$(IsPackable)' == 'true'">
    <ItemGroup>
      <_FsgapExactProjectReferences Include="@(_ProjectReferencesWithVersions)">
        <ProjectVersion>[%(_ProjectReferencesWithVersions.ProjectVersion)]</ProjectVersion>
      </_FsgapExactProjectReferences>
      <_ProjectReferencesWithVersions Remove="@(_ProjectReferencesWithVersions)" />
      <_ProjectReferencesWithVersions Include="@(_FsgapExactProjectReferences)" />
    </ItemGroup>
  </Target>

</Project>
